<Window x:Class="RequestManagerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система управления заявками" 
        Height="750" Width="1200" 
        MinHeight="600" MinWidth="1000" 
        Icon="rma.ico"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Background="#F0F2F5" FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#4361EE"/>
        <SolidColorBrush x:Key="PrimaryHover" Color="#3A56D4"/>
        <SolidColorBrush x:Key="SidebarColor" Color="#1E1E2F"/>
        <SolidColorBrush x:Key="SidebarHover" Color="#2A2A40"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPassword" TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="White">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0AEC0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="25,0,0,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0,8,8,0" Margin="0,0,10,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SidebarHover}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="AuthScreen" Background="#F0F2F5" Panel.ZIndex="100">
            <Border Width="380" Background="White" CornerRadius="12" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <Grid>
                    <StackPanel x:Name="PanelLogin" Visibility="Visible">
                        <TextBlock Text="Вход в систему" FontSize="26" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                        <TextBlock Text="Логин" Foreground="#64748B" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtLoginUser" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"/>
                        <TextBlock Text="Пароль" Foreground="#64748B" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="txtLoginPass" Style="{StaticResource ModernPassword}" Margin="0,0,0,30"/>
                        <Button Content="Войти" Style="{StaticResource PrimaryButton}" Click="BtnLogin_Click"/>
                        <TextBlock HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Hyperlink Click="LinkToRegister_Click" Foreground="{StaticResource PrimaryColor}" TextDecorations="None">Создать аккаунт</Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel x:Name="PanelRegister" Visibility="Collapsed">
                        <TextBlock Text="Регистрация" FontSize="26" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                        <TextBlock Text="ФИО:" Foreground="#64748B" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtRegName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15"/>
                        <TextBlock Text="Придумайте логин:" Foreground="#64748B" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtRegLogin" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15"/>
                        <TextBlock Text="Придумайте пароль:" Foreground="#64748B" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="txtRegPass" Style="{StaticResource ModernPassword}" Margin="0,0,0,30"/>
                        <Button Content="Зарегистрироваться" Style="{StaticResource PrimaryButton}" Background="#10B981" Click="BtnRegister_Click"/>
                        <TextBlock HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Hyperlink Click="LinkToLogin_Click" Foreground="{StaticResource PrimaryColor}" TextDecorations="None">Уже есть аккаунт? Войти</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <Grid x:Name="MainScreen" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SidebarColor}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,40,0,40">
                        <TextBlock Text="⚙️ ReqManager" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <Border Background="#2A2A40" CornerRadius="8" Margin="20,20,20,0" Padding="15">
                            <StackPanel>
                                <TextBlock x:Name="txtUserName" Text="ФИО Пользователя" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Button x:Name="NavBtnAdmin" Content="📁 Справочники" Style="{StaticResource MenuButton}" Click="NavAdmin_Click"/>
                        <Button x:Name="NavBtnUser" Content="➕ Создать заявку" Style="{StaticResource MenuButton}" Click="NavUser_Click"/>
                        <Button x:Name="NavBtnArchive" Content="🗄 Архив заявок" Style="{StaticResource MenuButton}" Click="NavArchive_Click"/>
                    </StackPanel>

                    <Button Grid.Row="2" Content="🚪 Выход" Style="{StaticResource MenuButton}" Foreground="#EF4444" Click="Logout_Click" Margin="0,0,0,30"/>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="30">
                <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="{x:Type TabItem}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <TabItem>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Управление справочниками" FontSize="26" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,25"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15" >
                                            <TextBlock Text="Объекты обслуживания" FontSize="16" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" Width="200"/>
                                            <Button Content="📥 Импорт Excel" Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" Width="120" Height="32" BorderThickness="1" BorderBrush="{StaticResource BorderColor}" Click="ImportFacilities_Click">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                        <DataGrid Grid.Row="1" x:Name="dgFacilities" AutoGenerateColumns="True" CellEditEnding="Dg_CellEditEnding"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="20" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15" >
                                            <TextBlock Text="Услуги и сроки" FontSize="16" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" Width="200"/>
                                            <Button Content="📥 Импорт Excel" Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold" Width="120" Height="32" BorderThickness="1" BorderBrush="{StaticResource BorderColor}" Click="ImportServices_Click">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                        <DataGrid Grid.Row="1" x:Name="dgServices" AutoGenerateColumns="True" CellEditEnding="Dg_CellEditEnding"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem>
                        <Grid>
                            <TextBlock Text="Новая заявка" FontSize="26" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,25"/>

                            <Border Background="White" CornerRadius="12" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Top" Width="550" Margin="0,60,0,0" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Оформление запроса на обслуживание" FontSize="18" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,30" HorizontalAlignment="Center"/>

                                    <TextBlock Text="Выберите объект:" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="cbFacilities" DisplayMemberPath="Name" Height="40" Margin="0,0,0,20" FontSize="14"/>

                                    <TextBlock Text="Выберите услугу:" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="cbServices" DisplayMemberPath="Name" Height="40" Margin="0,0,0,20" FontSize="14"/>

                                    <TextBlock Text="Объем задач (количество):" Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtQuantity" Text="1" Style="{StaticResource ModernTextBox}" Margin="0,0,0,35"/>

                                    <Button Content="Отправить заявку в работу" Style="{StaticResource PrimaryButton}" Height="45" Click="CreateRequest_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,25" >
                                <TextBlock Text="Журнал заявок" FontSize="26" FontWeight="Bold" Foreground="#1E293B"/>
                            </StackPanel>

                            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="20" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Padding="15" Margin="0,0,0,20" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock Text="Период с:" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <DatePicker x:Name="dpStart" Width="120" Height="32" Margin="0,0,20,0"/>

                                            <TextBlock Text="по:" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <DatePicker x:Name="dpEnd" Width="120" Height="32" Margin="0,0,25,0"/>

                                            <TextBlock x:Name="lblFilterType" Text="Категория:" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="cbFilterType" Width="180" Height="32" Margin="0,0,25,0"/>

                                            <Button Content="Применить" Style="{StaticResource PrimaryButton}" Height="32" Width="110" Click="Filter_Click"/>
                                            <Button Content="Сбросить" Background="Transparent" Foreground="{StaticResource PrimaryColor}" FontWeight="SemiBold" BorderThickness="0" Margin="10,0,0,0" Cursor="Hand" Click="ResetFilter_Click"/>
                                        </WrapPanel>
                                    </Border>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                                        <CheckBox x:Name="chkShowCompleted" Content="Показывать выполненные" Foreground="#475569" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,30,0" Click="Filter_Click">
                                            <CheckBox.LayoutTransform>
                                                <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                                            </CheckBox.LayoutTransform>
                                        </CheckBox>
                                        <Button Content="📊 Экспорт в Excel" Height="35" Width="160" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="ExportExcel_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <Button x:Name="btnCompleteReq" Content="✔ Завершить выбранную" Height="35" Width="200" Margin="15,0,0,0" Background="#F59E0B" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="CompleteRequest_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>

                                    <DataGrid x:Name="dgRequests" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50"/>
                                            <DataGridTextColumn Header="ОБЪЕКТ" Binding="{Binding Facility.Name}" Width="*"/>
                                            <DataGridTextColumn Header="РАБОТА" Binding="{Binding ServiceName}" Width="*"/>
                                            <DataGridTextColumn x:Name="colWorkType" Header="ТИП РАБОТЫ" Binding="{Binding WorkType}" Width="*"/>
                                            <DataGridTextColumn Header="СРОК" Binding="{Binding DeadlineDays}" Width="70"/>
                                            <DataGridTextColumn Header="ОБЪЕМ" Binding="{Binding Quantity}" Width="70"/>
                                            <DataGridTextColumn Header="СТАТУС" Binding="{Binding Status}" Width="100"/>
                                            <DataGridTextColumn Header="ДАТА" Binding="{Binding FormattedDate}" Width="120"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>