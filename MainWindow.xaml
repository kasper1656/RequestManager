<Window x:Class="RequestManagerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система управления заявками" Height="750" Width="1200" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Background="#F4F6F9" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="White">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPassword" TargetType="PasswordBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="White">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#007BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0056B3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C2C7D0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0,0,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#494E53"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>

        <Border x:Name="AuthScreen" Background="#E9ECEF" Panel.ZIndex="100">
            <Border Width="350" Background="White" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
                <!-- Эффект DropShadowEffect был удален отсюда -->
                <Grid>
                    <StackPanel x:Name="PanelLogin" Visibility="Visible">
                        <TextBlock Text="Авторизация" FontSize="24" FontWeight="Bold" Foreground="#343A40" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="Логин:" Foreground="#495057" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtLoginUser" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15"/>
                        <TextBlock Text="Пароль:" Foreground="#495057" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="txtLoginPass" Style="{StaticResource ModernPassword}" Margin="0,0,0,20"/>
                        <Button Content="Войти" Style="{StaticResource PrimaryButton}" Click="BtnLogin_Click"/>
                        <TextBlock HorizontalAlignment="Center" Margin="0,15,0,0">
                            <Hyperlink Click="LinkToRegister_Click" Foreground="#007BFF">Нет аккаунта? Зарегистрироваться</Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel x:Name="PanelRegister" Visibility="Collapsed">
                        <TextBlock Text="Регистрация" FontSize="24" FontWeight="Bold" Foreground="#343A40" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="ФИО:" Foreground="#495057" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtRegName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>
                        <TextBlock Text="Логин:" Foreground="#495057" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtRegLogin" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>
                        <TextBlock Text="Пароль:" Foreground="#495057" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="txtRegPass" Style="{StaticResource ModernPassword}" Margin="0,0,0,20"/>
                        <Button Content="Зарегистрироваться" Style="{StaticResource PrimaryButton}" Background="#28A745" Click="BtnRegister_Click"/>
                        <TextBlock HorizontalAlignment="Center" Margin="0,15,0,0">
                            <Hyperlink Click="LinkToLogin_Click" Foreground="#007BFF">Уже есть аккаунт? Войти</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <Grid x:Name="MainScreen" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#343A40">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="20,30,20,30">
                        <TextBlock Text="ReqManager" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtUserName" Text="ФИО Пользователя" Foreground="#ADB5BD" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                        <Border Background="#495057" Height="1" Margin="0,20,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <Button x:Name="NavBtnAdmin" Content="📁 Справочники" Style="{StaticResource MenuButton}" Click="NavAdmin_Click"/>
                        <Button x:Name="NavBtnUser" Content="➕ Создать заявку" Style="{StaticResource MenuButton}" Click="NavUser_Click"/>
                        <Button x:Name="NavBtnArchive" Content="🗄 Архив заявок" Style="{StaticResource MenuButton}" Click="NavArchive_Click"/>
                    </StackPanel>
                    <Button Grid.Row="2" Content="🚪 Выйти из системы" Style="{StaticResource MenuButton}" Foreground="#E74C3C" Click="Logout_Click" Margin="0,0,0,20"/>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="20">
                <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="{x:Type TabItem}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <TabItem>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Управление справочниками" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="Объекты" FontWeight="Bold" VerticalAlignment="Center" Width="150"/>
                                            <Button Content="📥 Импорт Excel" Background="#6C757D" Foreground="White" Width="120" Height="25" Click="ImportFacilities_Click"/>
                                        </StackPanel>
                                        <DataGrid Grid.Row="1" x:Name="dgFacilities" AutoGenerateColumns="True" Background="White" CellEditEnding="Dg_CellEditEnding"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="Услуги (Типы и сроки)" FontWeight="Bold" VerticalAlignment="Center" Width="150"/>
                                            <Button Content="📥 Импорт Excel" Background="#6C757D" Foreground="White" Width="120" Height="25" Click="ImportServices_Click"/>
                                        </StackPanel>
                                        <DataGrid Grid.Row="1" x:Name="dgServices" AutoGenerateColumns="True" Background="White" CellEditEnding="Dg_CellEditEnding"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem>
                        <Grid>
                            <TextBlock Text="Регистрация новой заявки" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20"/>
                            <Border Background="White" CornerRadius="8" Padding="30" HorizontalAlignment="Left" VerticalAlignment="Top" Width="500" Margin="0,50,0,0">
                                <StackPanel>
                                    <TextBlock Text="Выберите объект:" Foreground="#495057" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cbFacilities" DisplayMemberPath="Name" Height="35" Margin="0,0,0,15"/>
                                    <TextBlock Text="Выберите услугу:" Foreground="#495057" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="cbServices" DisplayMemberPath="Name" Height="35" Margin="0,0,0,15"/>
                                    <TextBlock Text="Объем задач (шт):" Foreground="#495057" Margin="0,0,0,5"/>
                                    <TextBox x:Name="txtQuantity" Text="1" Style="{StaticResource ModernTextBox}" Margin="0,0,0,25"/>
                                    <Button Content="Создать заявку" Style="{StaticResource PrimaryButton}" Click="CreateRequest_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Архив заявок" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15" Background="#F8F9FA" />
                                    <WrapPanel Grid.Row="0" Margin="10">
                                        <TextBlock Text="Период с:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <DatePicker x:Name="dpStart" Width="110" Margin="0,0,15,0"/>

                                        <TextBlock Text="по:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <DatePicker x:Name="dpEnd" Width="110" Margin="0,0,20,0"/>

                                        <TextBlock x:Name="lblFilterType" Text="Тип работы:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <ComboBox x:Name="cbFilterType" Width="150" Margin="0,0,15,0"/>

                                        <Button Content="🔍 Применить" Style="{StaticResource PrimaryButton}" Height="30" Width="100" Click="Filter_Click"/>
                                        <Button Content="Сбросить" Background="Transparent" Foreground="#007BFF" BorderThickness="0" Margin="10,0,0,0" Click="ResetFilter_Click"/>
                                    </WrapPanel>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                                        <CheckBox x:Name="chkShowCompleted" Content="Показывать выполненные" VerticalAlignment="Center" Click="Filter_Click"/>
                                        <Button Content="📊 Экспорт в Excel" Margin="20,0,0,0" Width="150" Height="35" Style="{StaticResource PrimaryButton}" Background="#28A745" Click="ExportExcel_Click"/>
                                        <Button x:Name="btnCompleteReq" Content="✔ Отметить выполненной" Margin="10,0,0,0" Width="180" Height="35" Style="{StaticResource PrimaryButton}" Background="#17A2B8" Click="CompleteRequest_Click"/>
                                    </StackPanel>

                                    <DataGrid x:Name="dgRequests" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" Background="White" RowHeight="35">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="№" Binding="{Binding Id}"/>
                                            <DataGridTextColumn Header="Объект" Binding="{Binding Facility.Name}" Width="150"/>
                                            <DataGridTextColumn Header="Работа" Binding="{Binding ServiceName}" Width="150"/>
                                            <DataGridTextColumn x:Name="colWorkType" Header="Тип работы" Binding="{Binding WorkType}" Width="120"/>
                                            <DataGridTextColumn Header="Сроки(дн)" Binding="{Binding DeadlineDays}"/>
                                            <DataGridTextColumn Header="Объем" Binding="{Binding Quantity}"/>
                                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                                            <DataGridTextColumn Header="Дата" Binding="{Binding FormattedDate}" Width="120"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>